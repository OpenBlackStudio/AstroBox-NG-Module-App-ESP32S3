# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# S3 PSRAM Support
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=n
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
# esp-idf-sys builds from target/.../esp-idf-sys-*/out, so point back to module root.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../../../../partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Bluetooth Support
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=5
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_VFS_MAX_COUNT=16

# ==== 新增：MicroSD (SDMMC over SPI) + FATFS + HTTPS ====
CONFIG_FATFS_ENABLED=y
CONFIG_FATFS_CODEPAGE_UTF8=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_FS_LOCK=16
CONFIG_FATFS_PER_FILE_CACHE=y

CONFIG_SDMMC_ENABLED=y
CONFIG_SDMMC_HOST_DEFAULT_MAX_CURRENT_200MA=y
CONFIG_SDIO_SLAVE_SUPPORT=n

# SNTP (日志文件名需要时间)
CONFIG_LWIP_SNTP_ENABLED=y
CONFIG_SNTP_SERVER_NAME="pool.ntp.org"
CONFIG_SNTP_UPDATE_DELAY=3600000

# HTTPS / TLS
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# 给 HTTP 客户端 + 下载缓冲多留一些堆空间
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Use this to set FreeRTOS kernel tick frequency to 1000 Hz (100 Hz by default).
# This allows to use 1 ms granularity for thread sleeps (10 ms by default).
#CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
