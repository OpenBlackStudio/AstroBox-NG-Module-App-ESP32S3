import "fonts/InterVF.ttf";
import "fonts/SarasaUiSC-Regular-subset.ttf";

export component App inherits Window {
    width: 240px;
    height: 240px;

    in-out property <string> stats-text: "";
    in-out property <string> touch-text: "";

    in-out property <bool> connected: false;
    in-out property <int> connected-device-count: 0;
    in-out property <string> device-name: "";
    in-out property <int> battery-percent: 0;
    in-out property <string> charge-text: "2天前充电";
    in-out property <string> net-up-text: "0 byte/s ↑";
    in-out property <string> net-down-text: "0 byte/s ↓";

    background: #252628;
    default-font-family: "Inter";

    Rectangle {
        width: 240px;
        height: 240px;
        border-radius: 120px;
        clip: true;
        background: #000000;

        Rectangle {
            visible: root.connected;

            Rectangle {
                x: 88px;
                y: 11px;
                width: 6px;
                height: 6px;
                border-radius: 4px;
                background: #FFFFFF;
            }

            Rectangle {
                x: 103px;
                y: 8px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #4E5054;
            }

            Rectangle {
                x: 117px;
                y: 7px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #4E5054;
            }

            Rectangle {
                x: 131px;
                y: 8px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #4E5054;
            }

            Rectangle {
                x: 145px;
                y: 11px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: #4E5054;
            }

            Text {
                x: 45px;
                y: 91px;
                width: 34px;
                height: 19px;
                text: root.battery-percent + "%";
                color: #FFFFFF;
                opacity: 0.75;
                font-size: 14px;
                font-weight: 500;
                font-family: "Inter";
                letter-spacing: -0.8px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                x: 83px;
                y: 93px;
                width: 27px;
                height: 13px;
                border-width: 1.1px;
                border-color: rgba(255, 255, 255, 0.55);
                border-radius: 2px;
                background: transparent;
                opacity: 0.75;

                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: root.battery-percent * 0.21px;
                    height: 8.8px;
                    border-radius: 1px;
                    background: #FFFFFF;
                }

                Rectangle {
                    x: 27px;
                    y: 4.3px;
                    width: 2.2px;
                    height: 4.3px;
                    border-radius: 1px;
                    background: rgba(255, 255, 255, 0.55);
                }
            }

            Text {
                x: 116px;
                y: 91px;
                width: 78px;
                height: 19px;
                text: root.charge-text;
                color: #FFFFFF;
                opacity: 0.75;
                font-size: 14px;
                font-weight: 450;
                font-family: "Sarasa UI SC";
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Image {
                source: @image-url("assets/brand-dot.png");
                x: 33px;
                y: 114px;
                width: 6.5px;
                height: 6.5px;
                image-fit: fill;
            }

            Text {
                x: 30px;
                y: 104px;
                width: 180px;
                height: 30px;
                text: root.device-name;
                color: #FFFFFF;
                font-size: 17px;
                font-weight: 600;
                font-family: "Inter";
                letter-spacing: -0.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                x: 45px;
                y: 132px;
                width: 70px;
                height: 20px;
                text: root.net-up-text;
                color: #FFFFFF;
                opacity: 0.75;
                font-size: 14px;
                font-weight: 500;
                font-family: "Inter";
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                x: 120px;
                y: 136px;
                width: 1px;
                height: 14px;
                background: #FFFFFF;
                opacity: 0.75;
            }

            Text {
                x: 125px;
                y: 132px;
                width: 70px;
                height: 20px;
                text: root.net-down-text;
                color: #FFFFFF;
                opacity: 0.75;
                font-size: 14px;
                font-weight: 500;
                font-family: "Inter";
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                x: 103px;
                y: 200px;
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: #2F3136;
                opacity: 0.95;

                Text {
                    text: "⚙";
                    x: 7px;
                    y: 3px;
                    width: 20px;
                    height: 24px;
                    color: #FFFFFF;
                    font-size: 20px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            visible: !root.connected;
            width: 240px;
            height: 240px;
            background: transparent;


            property <float> pulse-opacity: 0.28;

            states [
                breathing when !root.connected : {
                    pulse-opacity: 1.0;
                    in {
                        animate pulse-opacity {
                            duration: 1100ms;
                            iteration-count: -1.0;
                            direction: alternate;
                            easing: ease-in-out;
                        }
                    }
                }
            ]

            Rectangle {
                x: 70px;
                y: 109px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #f0d872;
                opacity: parent.pulse-opacity;
            }

            Text {
                x: 88px;
                y: 103px;
                width: 82px;
                height: 24px;
                text: "等待连接...";
                color: #FFFFFF;
                font-size: 16px;
                font-weight: 520;
                font-family: "Sarasa UI SC";
                opacity: 0.55 + parent.pulse-opacity * 0.45;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }

    Text {
        visible: false && root.stats-text != "";
        text: root.stats-text;
        x: 6px;
        y: 6px;
        color: #B6FFD2;
        font-size: 7px;
        font-family: "Inter";
        opacity: 0.65;
    }

    Text {
        visible: false && root.touch-text != "";
        text: root.touch-text;
        x: 6px;
        y: 218px;
        width: 228px;
        color: #BFD7FF;
        font-size: 7px;
        font-family: "Inter";
        opacity: 0.7;
    }
}
