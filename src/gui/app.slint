import "fonts/InterVF.ttf";
import "fonts/SarasaUiSC-Regular-subset.ttf";

export component App inherits Window {
    width: 240px;
    height: 320px;

    in-out property <string> stats-text: "";
    in-out property <string> touch-text: "";

    in-out property <bool> connected: false;
    in-out property <int> connected-device-count: 0;
    in-out property <string> device-name: "";
    in-out property <int> battery-percent: 0;
    in-out property <string> charge-text: "2天前充电";
    in-out property <string> net-up-text: "0 byte/s ↑";
    in-out property <string> net-down-text: "0 byte/s ↓";

    // ============ 安装资源面板（长按 ⚙ 呼出） ============
    in-out property <bool> resource-panel: false;
    // 当前页：0=本地包(SD) 1=AstroBox 官方源（曾经 2=米坛 因合规移除，UI 不保留）
    in-out property <int> repo-source-tab: 0;
    // 列表项（每条单行 text，最多 5 条）
    in-out property <string> list-item-0: "";
    in-out property <string> list-item-1: "";
    in-out property <string> list-item-2: "";
    in-out property <string> list-item-3: "";
    in-out property <string> list-item-4: "";
    in-out property <int> list-page: 0;
    in-out property <int> list-total: 0;
    // 进度 / 顶部提示（安装 / 加载中）
    in-out property <string> install-progress-text: "";

    // ===== 回调（由 Rust slint_ui.rs 注册） =====
    callback settings-long-pressed();
    callback resource-close();
    callback source-switched(int <new-tab-index>);
    callback list-prev-page();
    callback list-next-page();
    callback list-item-pressed(int <row-index>);

    background: #252628;
    default-font-family: "Inter";

    Rectangle {
        width: 240px;
        height: 320px;
        clip: true;
        background: #000000;

        // ── Connected state ──
        Rectangle {
            visible: root.connected && !root.resource-panel;

            // LED connection-count dots (top row, centered)
            Rectangle { x: 88px; y: 14px; width: 6px; height: 6px; border-radius: 3px; background: #FFFFFF; }
            Rectangle { x: 103px; y: 11px; width: 6px; height: 6px; border-radius: 3px; background: #4E5054; }
            Rectangle { x: 117px; y: 10px; width: 6px; height: 6px; border-radius: 3px; background: #4E5054; }
            Rectangle { x: 131px; y: 11px; width: 6px; height: 6px; border-radius: 3px; background: #4E5054; }
            Rectangle { x: 145px; y: 14px; width: 6px; height: 6px; border-radius: 3px; background: #4E5054; }

            // ── Top status bar: battery + charge ──
            Text {
                x: 45px; y: 42px; width: 34px; height: 19px;
                text: root.battery-percent + "%";
                color: #FFFFFF; opacity: 0.75; font-size: 14px; font-weight: 500;
                font-family: "Inter"; letter-spacing: -0.8px;
                horizontal-alignment: left; vertical-alignment: center;
            }
            Rectangle {
                x: 83px; y: 44px; width: 27px; height: 13px;
                border-width: 1.1px; border-color: rgba(255, 255, 255, 0.55);
                border-radius: 2px; background: transparent; opacity: 0.75;
                Rectangle {
                    x: 2px; y: 2px;
                    width: root.battery-percent * 0.21px; height: 8.8px;
                    border-radius: 1px; background: #FFFFFF;
                }
                Rectangle { x: 27px; y: 4.3px; width: 2.2px; height: 4.3px; border-radius: 1px; background: rgba(255, 255, 255, 0.55); }
            }
            Text {
                x: 116px; y: 42px; width: 78px; height: 19px;
                text: root.charge-text;
                color: #FFFFFF; opacity: 0.75; font-size: 14px; font-weight: 450;
                font-family: "Sarasa UI SC";
                horizontal-alignment: left; vertical-alignment: center;
            }

            // ── Separator line ──
            Rectangle { x: 30px; y: 75px; width: 180px; height: 1px; background: rgba(255, 255, 255, 0.1); }

            // ── Device name (centered) ──
            Image {
                source: @image-url("assets/brand-dot.png");
                x: 33px; y: 105px; width: 6.5px; height: 6.5px; image-fit: fill;
            }
            Text {
                x: 30px; y: 95px; width: 180px; height: 34px;
                text: root.device-name;
                color: #FFFFFF; font-size: 18px; font-weight: 600;
                font-family: "Inter"; letter-spacing: -0.5px;
                horizontal-alignment: center; vertical-alignment: center;
            }

            // ── Network speeds ──
            Text {
                x: 45px; y: 160px; width: 70px; height: 20px;
                text: root.net-up-text;
                color: #FFFFFF; opacity: 0.75; font-size: 14px; font-weight: 500;
                font-family: "Inter"; horizontal-alignment: left; vertical-alignment: center;
            }
            Rectangle { x: 120px; y: 164px; width: 1px; height: 14px; background: #FFFFFF; opacity: 0.75; }
            Text {
                x: 125px; y: 160px; width: 70px; height: 20px;
                text: root.net-down-text;
                color: #FFFFFF; opacity: 0.75; font-size: 14px; font-weight: 500;
                font-family: "Inter"; horizontal-alignment: left; vertical-alignment: center;
            }

            // ── Install progress text ──
            Text {
                x: 10px; y: 218px; width: 220px; height: 20px;
                text: root.install-progress-text;
                color: #9df0c3; opacity: 0.85; font-size: 12px;
                font-family: "Sarasa UI SC";
                horizontal-alignment: center; vertical-alignment: center;
            }

            // ── Settings button (bottom) ── 长按 500ms 呼出面板
            Rectangle {
                x: 103px; y: 270px; width: 34px; height: 34px;
                border-radius: 17px; background: #2F3136; opacity: 0.95;
                property <duration> held-for: 0ms;
                property <bool> is-down: false;
                states [
                    held when root.is-down : {
                        held-for: 600ms;
                        in { animate held-for { duration: 500ms; } }
                        completed: { if root.is-down { root.settings-long-pressed(); } }
                    }
                ]
                TouchArea {
                    width: parent.width; height: parent.height;
                    pointer-event-type: down => {
                        root.held-for = 0ms;
                        root.is-down = true;
                    }
                    pointer-event-type: up => {
                        root.is-down = false;
                    }
                    pointer-event-type: cancel => {
                        root.is-down = false;
                    }
                }
                Text {
                    text: "⚙";
                    x: 7px; y: 3px; width: 20px; height: 24px;
                    color: #FFFFFF; font-size: 20px; font-weight: 500;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
        }

        // ── 安装资源面板 ──
        Rectangle {
            visible: root.resource-panel;
            width: 240px; height: 320px; background: #18191B;

            // 顶栏：关闭 + Tab
            Rectangle { x: 0px; y: 0px; width: 240px; height: 34px; background: #202124; }
            Text {
                x: 10px; y: 4px; width: 26px; height: 26px;
                text: "×"; color: #FFFFFF; font-size: 20px; font-weight: 600;
                vertical-alignment: center;
                TouchArea {
                    width: 30px; height: 30px;
                    clicked => root.resource-close();
                }
            }
            Text {
                x: 46px; y: 6px; width: 150px; height: 24px;
                text: "安装资源"; color: #FFFFFF;
                font-size: 15px; font-weight: 600; font-family: "Sarasa UI SC";
                horizontal-alignment: left; vertical-alignment: center;
            }

            // 2 个 Tab 按钮（原为 3 个，Tab 2「米坛」因 BandBBS 服务条款禁止未授权抓取而合规移除）
            define TabBtn := Rectangle {
                in property <int> tab-index;
                in property <string> label;
                in property <int> current-tab;
                width: 110px; height: 26px;
                border-radius: 6px;
                background: (root.repo-source-tab == self.tab-index) ? #3b82f6 : #2a2b2e;
                Text {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    text: self.label;
                    color: #FFFFFF; font-size: 13px; font-weight: 550;
                    font-family: "Sarasa UI SC";
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.source-switched(self.tab-index); }
                }
            }
            TabBtn { x: 6px;   y: 38px; tab-index: 0; label: "本地 (SD)"; current-tab: root.repo-source-tab; }
            TabBtn { x: 124px; y: 38px; tab-index: 1; label: "AstroBox";  current-tab: root.repo-source-tab; }

            // 安装进度条/提示（复用 install-progress-text）
            Text {
                x: 8px; y: 72px; width: 224px; height: 20px;
                text: root.install-progress-text;
                color: #9df0c3; opacity: 0.9; font-size: 12px;
                font-family: "Sarasa UI SC";
                horizontal-alignment: center; vertical-alignment: center;
            }

            // 列表 5 行：每行一个 TouchArea 可点击
            define ListRow := Rectangle {
                in property <int> row-index;
                in property <string> text;
                x: 8px; width: 224px; height: 38px;
                y: 96px + self.row-index * 40px;
                background: #232428; border-radius: 6px;
                Text {
                    x: 10px; y: 0; width: 204px; height: parent.height;
                    text: self.text;
                    color: #FFFFFF; opacity: 0.95;
                    font-size: 13px; font-family: "Sarasa UI SC";
                    vertical-alignment: center;
                    text-overflow: ellipsis;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => { root.list-item-pressed(self.row-index); }
                }
            }
            ListRow { row-index: 0; text: root.list-item-0; }
            ListRow { row-index: 1; text: root.list-item-1; }
            ListRow { row-index: 2; text: root.list-item-2; }
            ListRow { row-index: 3; text: root.list-item-3; }
            ListRow { row-index: 4; text: root.list-item-4; }

            // 底部分页 + 统计
            Text {
                x: 10px; y: 298px; width: 130px; height: 20px;
                text: (root.list-total > 0) ? ("共 " + root.list-total + " 项, 页 " + (root.list-page + 1)) : "无条目";
                color: #FFFFFF; opacity: 0.6; font-size: 12px;
                vertical-alignment: center;
            }
            Rectangle {
                x: 150px; y: 294px; width: 36px; height: 24px;
                background: #2a2b2e; border-radius: 6px;
                Text {
                    width: parent.width; height: parent.height;
                    text: "上一页"; color: #FFFFFF; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => root.list-prev-page();
                }
            }
            Rectangle {
                x: 190px; y: 294px; width: 36px; height: 24px;
                background: #2a2b2e; border-radius: 6px;
                Text {
                    width: parent.width; height: parent.height;
                    text: "下一页"; color: #FFFFFF; font-size: 12px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea {
                    width: parent.width; height: parent.height;
                    clicked => root.list-next-page();
                }
            }
        }

        // ── Disconnected state ──
        Rectangle {
            visible: !root.connected && !root.resource-panel;
            width: 240px; height: 320px; background: transparent;

            property <float> pulse-opacity: 0.28;
            states [
                breathing when !root.connected : {
                    pulse-opacity: 1.0;
                    in {
                        animate pulse-opacity {
                            duration: 1100ms; iteration-count: -1.0;
                            direction: alternate; easing: ease-in-out;
                        }
                    }
                }
            ]
            Rectangle {
                x: 70px; y: 154px; width: 12px; height: 12px;
                border-radius: 6px; background: #f0d872;
                opacity: parent.pulse-opacity;
            }
            Text {
                x: 88px; y: 148px; width: 82px; height: 24px;
                text: "等待连接...";
                color: #FFFFFF; font-size: 16px; font-weight: 520;
                font-family: "Sarasa UI SC";
                opacity: 0.55 + parent.pulse-opacity * 0.45;
                horizontal-alignment: left; vertical-alignment: center;
            }
        }
    }

    Text { visible: false && root.stats-text != ""; text: root.stats-text; x: 6px; y: 6px; color: #B6FFD2; font-size: 7px; font-family: "Inter"; opacity: 0.65; }
    Text { visible: false && root.touch-text != ""; text: root.touch-text; x: 6px; y: 298px; width: 228px; color: #BFD7FF; font-size: 7px; font-family: "Inter"; opacity: 0.7; }
}
